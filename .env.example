# Public content reader (safe publishable/anon key; never use the service role in client code)
SUPABASE_URL=https://fnxbilbihakhqvxjmoqo.supabase.co
SUPABASE_ANON_KEY=

# Server-only editorial tools. Do not prefix these with NEXT_PUBLIC_ or VITE_.
