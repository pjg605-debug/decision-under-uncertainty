REVIEW_DASHBOARD_TOKEN=

# Airtable outage fallback. Keep AIRTABLE_TOKEN server-only.
# auto merges both sources and prefers Supabase for duplicate slugs.
ARTICLE_SOURCE_MODE=auto
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_ARTICLES_TABLE_ID=

