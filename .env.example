# Public content reader (safe publishable/anon key; never use the service role in client code)
SUPABASE_URL=https://fnxbilbihakhqvxjmoqo.supabase.co
SUPABASE_ANON_KEY=

# Server-only editorial tools. Do not prefix these with NEXT_PUBLIC_ or VITE_.
# Prefer SUPABASE_SECRET_KEY (newer "sb_secret_..." format) when your
# Supabase project issues one; SUPABASE_SERVICE_ROLE_KEY (legacy "eyJ..."
# JWT) still works and is used automatically if SUPABASE_SECRET_KEY is
# unset. See core/supabase-auth.mjs.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REVIEW_DASHBOARD_TOKEN=

# Server-only #insight incoming webhook. Register separately in GitHub Actions
# and Sites production environment variables (as a secret), never in hosting.json.
SLACK_INSIGHT_WEBHOOK_URL=

# Airtable outage fallback. Keep AIRTABLE_TOKEN server-only.
# auto merges both sources and prefers Supabase for duplicate slugs.
ARTICLE_SOURCE_MODE=auto
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appwRBRbocw1KUlHa
AIRTABLE_ARTICLES_TABLE_ID=tblZGa8VwchQTAznx

# Used for absolute social metadata in production.
SITE_URL=https://decision-under-uncertainty.pjg605.chatgpt.site
