{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "EvidencePackage",
  "type": "object",
  "required": ["case_id", "sources"],
  "additionalProperties": false,
  "properties": {
    "case_id": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "title", "author_or_institution", "date", "citation",
          "source_type", "evidence_class", "supported_claim"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "author_or_institution": { "type": "string" },
          "date": { "type": "string" },
          "citation": { "type": "string", "description": "URL or bibliographic reference" },
          "source_type": {
            "enum": [
              "PRIMARY",
              "GOVERNMENT_ARCHIVE",
              "ACADEMIC",
              "REFERENCE",
              "UNIVERSITY_RESEARCH",
              "QUALITY_MEDIA",
              "WIKIPEDIA_DISCOVERY"
            ]
          },
          "evidence_class": { "enum": ["FACT", "CONTEMPORARY_BELIEF", "STATED_RATIONALE", "INFERENCE"] },
          "supported_claim": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
