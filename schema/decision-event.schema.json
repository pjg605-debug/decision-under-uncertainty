{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-event.schema.json",
  "title": "DecisionEvent",
  "type": "object",
  "required": [
    "id", "title", "case_type", "fame_level", "t0", "stakes",
    "known_at_t0", "unknown_at_t0", "options", "actual_decision",
    "decision_quality", "outcome_quality", "outcome"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string" },
    "case_type": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["military", "political", "diplomacy", "exploration", "science", "crisis", "survival", "industry"]
      }
    },
    "fame_level": { "enum": ["well_known", "medium", "lesser_known"] },
    "era": { "type": "string" },
    "location": { "type": "string" },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    },
    "t0": {
      "type": "object",
      "required": ["definition", "date", "location"],
      "additionalProperties": false,
      "properties": {
        "definition": { "type": "string", "description": "Precise moment the decision is frozen at" },
        "date": { "type": "string" },
        "location": { "type": "string" }
      }
    },
    "stakes": { "type": "string" },
    "known_at_t0": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement", "evidence_class"],
        "additionalProperties": false,
        "properties": {
          "statement": { "type": "string" },
          "evidence_class": { "enum": ["FACT", "CONTEMPORARY_BELIEF", "STATED_RATIONALE", "INFERENCE"] }
        }
      }
    },
    "unknown_at_t0": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement", "evidence_class"],
        "additionalProperties": false,
        "properties": {
          "statement": { "type": "string" },
          "evidence_class": { "enum": ["FACT", "CONTEMPORARY_BELIEF", "STATED_RATIONALE", "INFERENCE"] }
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "label", "description", "upside", "downside", "why_it_made_sense", "risk_carried"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "upside": { "type": "string" },
          "downside": { "type": "string" },
          "why_it_made_sense": { "type": "string" },
          "risk_carried": { "type": "string" }
        }
      }
    },
    "actual_decision": {
      "type": "object",
      "required": ["chosen_option_id", "decided_by", "decided_when", "stated_basis", "constraints"],
      "additionalProperties": false,
      "properties": {
        "chosen_option_id": { "type": "string" },
        "decided_by": { "type": "string" },
        "decided_when": { "type": "string" },
        "stated_basis": { "type": "string" },
        "constraints": { "type": "string" }
      }
    },
    "decision_quality": {
      "type": "object",
      "required": ["rating", "justification"],
      "additionalProperties": false,
      "properties": {
        "rating": { "enum": ["STRONG", "REASONABLE", "WEAK", "UNCLEAR"] },
        "justification": { "type": "string" }
      }
    },
    "outcome_quality": {
      "type": "object",
      "required": ["rating", "justification"],
      "additionalProperties": false,
      "properties": {
        "rating": { "enum": ["GOOD", "BAD", "MIXED"] },
        "justification": { "type": "string" }
      }
    },
    "outcome": {
      "type": "object",
      "required": ["immediate", "long_term", "causal_directness"],
      "additionalProperties": false,
      "properties": {
        "immediate": { "type": "string" },
        "long_term": { "type": "string" },
        "causal_directness": { "enum": ["DIRECT", "CONTRIBUTING", "CONTESTED"] }
      }
    },
    "source_disagreements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "description"],
        "additionalProperties": false,
        "properties": {
          "topic": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "has_progressive_version": { "type": "boolean" }
  }
}
